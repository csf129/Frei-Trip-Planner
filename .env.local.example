# -----------------------------------------------------------------------------
# 1. Copy this whole file to a NEW file named exactly:  .env.local
#    (same folder as this file — the project root)
#
# 2. In Supabase: Project Settings (gear) → API (or "Data API" in newer UI).
#    - Project URL → paste into VITE_SUPABASE_URL below.
#    - "Publishable" / "anon" / "public" key (safe for the browser) → paste
#      into VITE_SUPABASE_ANON_KEY. Row Level Security protects the data.
#
#    Do NOT put the Secret / service_role key here.
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=paste_the_publishable_key_here
